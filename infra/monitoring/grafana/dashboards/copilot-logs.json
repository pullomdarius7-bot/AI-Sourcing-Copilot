{
  "uid": "copilot-logs",
  "title": "AI Sourcing Copilot - Logs",
  "tags": [
    "copilot",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log lines by service",
      "datasource": {
        "type": "loki",
        "uid": "copilot-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "copilot-loki"
          },
          "expr": "sum by (service) (count_over_time({job=\"copilot\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Errors and warnings by service",
      "datasource": {
        "type": "loki",
        "uid": "copilot-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "copilot-loki"
          },
          "expr": "sum by (service, level) (count_over_time({job=\"copilot\", service=~\"$service\", level=~\"ERROR|CRITICAL|WARNING\"}[$__interval]))",
          "legendFormat": "{{service}} {{level}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "logs",
      "title": "Errors",
      "datasource": {
        "type": "loki",
        "uid": "copilot-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "copilot-loki"
          },
          "expr": "{job=\"copilot\", service=~\"$service\", level=~\"ERROR|CRITICAL\"}",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "id": 3
    },
    {
      "type": "logs",
      "title": "All logs (filter with the search box)",
      "datasource": {
        "type": "loki",
        "uid": "copilot-loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "copilot-loki"
          },
          "expr": "{job=\"copilot\", service=~\"$service\"} |~ \"(?i)$search\"",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "id": 4
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "copilot-loki"
        },
        "query": {
          "label": "service",
          "stream": "{job=\"copilot\"}",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
