# Copy to .env with `make init` (generates secrets) or fill in by hand.

# --- PostgreSQL ---
POSTGRES_USER=copilot
POSTGRES_DB=copilot
POSTGRES_PASSWORD=change-me
# Password of the restricted role (copilot_app) the API connects as. Subject to row-level security.
# 16-128 characters from [A-Za-z0-9_-].
APP_DB_PASSWORD=change-me

# --- Auth secrets ---
# At least 32 characters. Rotating it signs everyone out.
JWT_SECRET=change-me
# Fernet key (urlsafe base64, 32 bytes). Encrypts TOTP seeds at rest. Losing it disables MFA logins.
MFA_ENCRYPTION_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true

# --- Public URLs ---
APP_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000
# Interface the web front end is published on. 127.0.0.1 = this machine only (put a reverse proxy in front);
# 0.0.0.0 = every interface (plain HTTP on a trusted network only).
FRONTEND_BIND=127.0.0.1
# Set to true when serving over HTTPS (adds the Secure flag to auth cookies).
COOKIE_SECURE=false
# Public host name. Used by the nginx + Let's Encrypt overlay (docker-compose.prod.yml) and by the Caddy profile.
DOMAIN=localhost

# --- Outgoing mail ---
# Default: bundled Mailpit (UI at http://localhost:8025) captures every message, nothing leaves the host.
# For real delivery point these at your own SMTP relay (e.g. a self-hosted Postfix).
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=AI Sourcing Copilot <no-reply@sourcing.local>

# --- Documents & storage ---
MAX_UPLOAD_MB=20
# auto = MinIO, falling back to local disk when MinIO is unreachable | minio | local
STORAGE_BACKEND=auto
MINIO_ROOT_USER=copilot-minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=documents

# --- Virus scanning ---
# both = built-in static checks + ClamAV (ClamAV needs ~1-2 GB RAM and downloads signatures on first start;
# uploads stay "scanning" until it is ready) | builtin = static checks only (not recommended for production)
SCAN_BACKEND=both

# --- Workers ---
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=5

# --- AI providers (all optional, none required) ---
# Providers are tried in this order; unconfigured ones are skipped. With none configured, documents are still
# scanned and parsed and analysis is marked "skipped". Local is first so documents stay on your network.
AI_PROVIDER_ORDER=local,anthropic,openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Point at any OpenAI-compatible server (vLLM, LM Studio, ...) to use it through the OpenAI adapter.
OPENAI_BASE_URL=https://api.openai.com/v1
# Self-hosted model via Ollama: docker compose --profile local-llm up -d, then
#   docker compose exec ollama ollama pull llama3.1:8b
# and set LOCAL_LLM_URL=http://ollama:11434
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.1:8b

# Sourcing assistant (Sprint 6). Works immediately without any model: in deterministic mode it plans with fixed rules
# and writes answers only from tool results. With a provider above configured, auto mode lets the model plan and word
# the answer; every statement is still checked against its cited sources and replaced by the deterministic answer if not.
# auto | deterministic | llm
AGENT_MODE=auto
AGENT_MAX_TOOL_CALLS=4
AGENT_RATE_PER_MINUTE=20
# Documents processed before the assistant existed are indexed during the first searches, this many per search.
AGENT_INDEX_ON_DEMAND_DOCS=20

# Monitoring (docker compose --profile monitoring up -d): Prometheus on 127.0.0.1:9090, Grafana on 127.0.0.1:3001.
# METRICS_TOKEN protects the API's /metrics endpoint; generated by init-env.sh.
METRICS_TOKEN=change-me
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=15d

# --- Requirement extraction & review ---
# true = whoever started an extraction, or reviewed any of its items, cannot approve it (four-eyes principle).
# Set to false only for very small teams where one person plays every role.
REQUIRE_SEPARATE_APPROVER=true
# Bulk verification only accepts grounded, unflagged values at or above this confidence.
BULK_VERIFY_MIN_CONFIDENCE=0.85
# Long documents are sent to the model in overlapping chunks of this many characters.
EXTRACTION_CHUNK_CHARS=40000

# --- Suppliers, RFQs & comparisons ---
# Numbers look like RFQ-2026-0001 and SUP-0001 (sequential per organization).
RFQ_NUMBER_PREFIX=RFQ
SUPPLIER_CODE_PREFIX=SUP
# Currency for new RFQs. Quotes in another currency are converted only with exchange rates recorded under Rates & units.
DEFAULT_CURRENCY=EUR
# Company name printed on RFQ PDFs and emails; empty = the organization name in the app.
ORG_DISPLAY_NAME=
# A unit price this fraction below the median of the other quotes is flagged as an abnormally low bid.
COMPARISON_OUTLIER_RATIO=0.5
# Quote analysis (Sprint 5). All calculations are deterministic; exchange rates and unit rules are entered in the app.
# An exchange rate older than this many days on the analysis date is flagged as stale.
FX_MAX_AGE_DAYS=30
# A quote that expires within this many days is flagged.
QUOTE_VALIDITY_WARNING_DAYS=7
# Largest CSV/XLSX price sheet accepted for quote import.
QUOTE_IMPORT_MAX_MB=5
# RFQ packages are emailed through the SMTP settings above (Mailpit by default, nothing leaves the host).
# EMAIL_FROM is the sender; the person who sends the RFQ is the Reply-To.

# --- Production operations (docs/DEPLOYMENT.md). ./scripts/configure-prod.sh <domain> <email> fills these in. ---
# Compose files and profiles used by every `docker compose` command in this directory.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PROFILES=monitoring,logging
# Release tag of the application images; written by scripts/deploy.sh and scripts/rollback.sh.
APP_VERSION=
# Address for Let's Encrypt expiry notices.
ACME_EMAIL=
# nginx: request body limit (keep a little above MAX_UPLOAD_MB) and who may register a new organization
# (1 = anyone, 0 = only the addresses in infra/nginx/register-allow.conf).
NGINX_CLIENT_MAX_BODY=25m
NGINX_REGISTER_DEFAULT=1
# Backups (scripts/backup.sh): where they go, how many days they are kept, a file holding the encryption
# passphrase (GPG AES-256; strongly recommended because backups contain this file), and an rsync target for the
# off-site copy, e.g. backup@backup.example.com:/srv/backups/copilot/
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE_FILE=
BACKUP_REMOTE=
# Optional webhook that receives {"text": "..."} when scripts/healthcheck.sh finds a problem.
ALERT_WEBHOOK_URL=
# Optional account for signed-in checks in scripts/validate.sh (a dedicated user without two-factor login).
VALIDATE_EMAIL=
VALIDATE_PASSWORD=

# --- Free trial ---
# Granted once, when an account finishes onboarding. It ends after TRIAL_DAYS or TRIAL_CREDITS manifest
# analyses, whichever is used up first.
TRIAL_DAYS=7
TRIAL_CREDITS=10

# --- Billing (Stripe) and credit metering ---
# Every AI call is checked and charged first: the account needs an active subscription or an unexpired trial,
# and enough credits. false switches that off entirely (installs that do not sell access).
BILLING_ENFORCED=true
# Secret API key (sk_live_... / sk_test_...) and the signing secret of the webhook endpoint (whsec_...).
# Webhook URL: https://<your domain>/api/webhooks/stripe  Events: checkout.session.completed,
# invoice.payment_succeeded, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create one monthly price per plan in Stripe and give it the plan key as its lookup key
# (solo_buyer_monthly $79, enterprise_buyer_monthly $249, supplier_monthly $149). Or paste the price ids here.
STRIPE_PRICE_SOLO_BUYER_MONTHLY=
STRIPE_PRICE_ENTERPRISE_BUYER_MONTHLY=
STRIPE_PRICE_SUPPLIER_MONTHLY=
# Credits granted at the start of each paid month. Unused credits do not roll over.
PLAN_CREDITS_SOLO=25
PLAN_CREDITS_ENTERPRISE=250
PLAN_CREDITS_SUPPLIER=100
# Credits per full analysis run and per model-written assistant answer. Manifest extraction costs 1 credit
# under 500 line items, otherwise 1 credit per 100 line items.
CREDIT_COST_DEEP_ANALYSIS=1
CREDIT_COST_ASSISTANT_ANSWER=1
# Pay-as-you-go top-ups: subscribers who are down to TOPUP_AVAILABLE_AT_OR_BELOW credits can buy between
# TOPUP_MIN_CREDITS and TOPUP_MAX_CREDITS extra credits at their plan's price per credit (in cents). No Stripe
# price needs to be created for this. Bought credits roll over and survive a cancellation.
TOPUP_PRICE_CENTS_SOLO=299
TOPUP_PRICE_CENTS_ENTERPRISE=99
TOPUP_PRICE_CENTS_SUPPLIER=149
TOPUP_MIN_CREDITS=5
TOPUP_MAX_CREDITS=500
TOPUP_AVAILABLE_AT_OR_BELOW=5
# People (active users plus open invitations) a team account may have before it subscribes. On a plan the
# plan decides: Solo Operator 1, Sourcing Team 5, Verified Supplier unlimited.
TRIAL_SEATS=5

# --- AI sourcing engine ---
# A buyer's request is matched against the marketplace; when nothing matches (or the buyer asks), the engine searches
# the web for wholesalers, distributors and liquidators, reads their sites (respecting robots.txt, public addresses
# only) and returns organized supplier profiles quoted from those sites. Web search uses a search API, never scraped
# search-result pages:
#   searxng: self-hosted (docker compose --profile search up -d; SEARXNG_URL=http://searxng:8080)
#   brave:   Brave Search API (BRAVE_API_KEY)
# Empty: marketplace matching only.
SEARCH_PROVIDER=
SEARXNG_URL=
SEARXNG_SECRET=change-me
BRAVE_API_KEY=
# Credits per web search (refunded when no supplier is found) and websites read per search.
CREDIT_COST_WEB_SOURCING=2
WEB_SOURCING_MAX_SITES=8
# Invitations to suppliers found on the web: auto (send when every safeguard passes) | review (record only) | off.
# Each business domain is emailed at most once per INVITE_COOLDOWN_DAYS, only at an address it published on its own
# site, with one-click unsubscribe. Anti-spam law requires a postal address in every email: invitations are held
# until INVITE_SENDER_POSTAL_ADDRESS is set.
SUPPLIER_INVITES=auto
INVITE_COOLDOWN_DAYS=90
INVITE_DAILY_LIMIT=200
INVITE_SENDER_POSTAL_ADDRESS=
PLATFORM_NAME=Sourcing Copilot
# Shown on the Billing page; Sourcing Team requests are marked priority.
SUPPORT_EMAIL=
